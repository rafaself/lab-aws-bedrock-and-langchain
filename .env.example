# AWS credentials used by boto3 (never commit your real .env)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Only needed for temporary credentials (STS, SSO, assumed roles)
# AWS_SESSION_TOKEN=your-session-token

# Alternatively, use a named profile instead of static keys:
# AWS_PROFILE=default

# Required by every notebook (Bedrock runtime clients)
AWS_DEFAULT_REGION=us-east-1
